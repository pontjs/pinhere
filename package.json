{
  "name": "@pontx/pinhere",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@10.14.0",
  "description": "Type-safe Pinhere SDK and preview-first CLI generated from the product-owned PontxSpec",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && pontx cli build",
    "contract:verify": "node scripts/verify-contract.mjs",
    "pontx": "pontx generate --use-remote",
    "generate:check": "node scripts/verify-generated.mjs",
    "type-check": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test:types": "tsc --project test/types/tsconfig.json",
    "test:package": "node scripts/verify-package.mjs",
    "test:matrix": "node scripts/verify-node-matrix.mjs",
    "quality": "pnpm contract:verify && pnpm generate:check && pnpm type-check && pnpm test:unit && pnpm build && pnpm test:types && pnpm test:e2e && pnpm test:package",
    "release:verify": "node scripts/verify-release-readiness.mjs && pnpm quality && pnpm test:matrix",
    "prepublishOnly": "pnpm release:verify"
  },
  "keywords": [
    "pinhere",
    "issue-tracking",
    "api",
    "sdk",
    "cli",
    "typescript"
  ],
  "author": "Pontx Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pontjs/pinhere.git"
  },
  "homepage": "https://github.com/pontjs/pinhere#readme",
  "bugs": {
    "url": "https://github.com/pontjs/pinhere/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pontx/sdk": "1.0.0-beta.9",
    "pontx": "1.0.0-beta.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pontx": {
    "specDir": "dist/bin"
  },
  "bin": {
    "pontx-pinhere": "./dist/bin/cli.cjs"
  }
}
